# ============================================================================
# Ayurvedic Meal Planner API — backend configuration
#
# Copy to backend/.env and fill in real values. backend/.env is gitignored;
# never commit it. Every value below has a default in config.py, so the only
# ones you must set are the Supabase pair (and OPENAI_API_KEY if you use the
# OpenAI-backed meal planning).
# ============================================================================

# --- Flask ------------------------------------------------------------------
FLASK_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Comma-separated exact origins allowed to call this API (scheme + host, no
# trailing slash). Defaults already cover Vite's local dev server and
# https://prakriva.vercel.app, and any *.vercel.app origin is allowed
# automatically for preview deployments — set this only if the frontend is
# served from a different domain.
# ALLOWED_ORIGINS=https://prakriva.vercel.app,http://localhost:5173

# --- Gemini (server-side only) ---------------------------------------------
# Powers diet chart generation on the doctor's Recipe Builder, the written
# analysis on the Patient Analysis page, the patient chatbot and lab-report
# extraction. MUST NOT be given a VITE_ prefix or moved to the frontend .env:
# that would compile the key into the browser bundle where anyone can read it.
# Leave unset to disable those features cleanly — diet charts then fall back to
# the FoodOScope recipe path.
#
# GEMINI_API_KEY2, GEMINI_API_KEY3, ... (up to GEMINI_API_KEY10) are optional
# extra keys, e.g. from a second/third Google AI Studio project. The backend
# rotates to the next one whenever the active key is rate-limited, over quota or
# rejected, and the key that last worked is tried first. GEMINI_API_KEY may also
# hold a comma-separated list. Only GEMINI_API_KEY is required; the others are
# headroom for the chatbot's call volume and for diet chart generation. See
# "Gemini key rotation" in the README.
# GEMINI_API_KEY=
# GEMINI_API_KEY2=
# GEMINI_API_KEY3=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TEMPERATURE=0.3
# GEMINI_MAX_TOKENS=900
# GEMINI_TIMEOUT_SECONDS=30

# --- Supabase (server-side only) -------------------------------------------
# The service-role key bypasses row level security. It must never reach the
# browser. Falls back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY when
# unset, which runs backend queries as the anon role instead.
# supabase-py validates the key as a JWT, so use the legacy service_role key
# rather than an sb_secret_... key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI -----------------------------------------------------------------
# Only required for the OpenAI-backed meal plan generation. The API boots
# without it; only requests that call OpenAI fail.
OPENAI_API_KEY=

# --- Database tables --------------------------------------------------------
GENERATED_PLANS_TABLE=generated_plans
DOCTOR_EDITS_TABLE=doctor_edits

# --- ML model ---------------------------------------------------------------
# Defaults resolve relative to backend/, not the process working directory.
MODEL_PATH=dosha_model.pkl
MODEL_VERSION=1.0.0

# --- Datasets ---------------------------------------------------------------
FOOD_DATASET_PATH=data/food_dataset.csv
DOSHA_DATASET_PATH=data/dosha_dataset.csv
PATIENT_DATASET_PATH=data/patient_dataset.csv
LIFESTYLE_DATASET_PATH=data/lifestyle_dataset.csv

# --- LLM --------------------------------------------------------------------
DEFAULT_MODEL=gpt-4
MAX_TOKENS=2000
TEMPERATURE=0.7
FOOD_SNIPPET_ROWS=60

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500

# Where flask-limiter keeps its counters. Defaults to "memory://" (in-process),
# which is correct while the API runs as a single worker — that is the case on
# Render's free plan, where WEB_CONCURRENCY=1. Point this at a shared Redis
# instance before running more than one worker or instance, otherwise each
# process enforces its own copy of the limit:
#   RATELIMIT_STORAGE_URI=redis://:password@host:6379/0
# REDIS_URL is honoured as a fallback, so a Render Key Value instance attached
# to the service works with no extra configuration.
# RATELIMIT_STORAGE_URI=memory://

# --- Caching ----------------------------------------------------------------
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=3600

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT={time} | {level} | {message}
