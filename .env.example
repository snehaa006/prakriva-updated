# Frontend (Vite) — safe to expose, protected by row level security.
# VITE_SUPABASE_ANON_KEY is accepted as an alternate name for the same key.
VITE_SUPABASE_URL=https://pghvmhakfwtxkwvlxokc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# FoodOScope (RecipeDB) API keys — used by the frontend, so they ship in the
# JS bundle and are visible to users. They're per-app quota tokens, not
# secrets. List several: the client automatically rotates to the next key
# when one is rate-limited (429), out of quota, expired, or rejected.
#
# These are baked in at build time, so changing them needs a redeploy — but
# they also work for signed-out visitors. For keys you can change without
# rebuilding, add rows to the `foodoscope_api_keys` table in Supabase instead
# (readable by signed-in users only); both sources are merged at runtime.
# Comma- (or newline-) separated:
VITE_FOODOSCOPE_API_KEYS=key-one,key-two,key-three
# Optional extra slots, merged with the list above (VITE_FOODOSCOPE_API_KEY_1
# through _20 are read). Handy on Vercel, where one var per key is easier to
# manage than a long comma-separated string:
# VITE_FOODOSCOPE_API_KEY_1=
# VITE_FOODOSCOPE_API_KEY_2=
# If none of the above are set, a single bundled fallback key is used.

# Backend only — bypasses row level security, never ship to the browser.
# Falls back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY if unset, but that
# means backend Supabase calls run as the anon role (subject to RLS) instead
# of the privileged service role — set these explicitly for full backend access.
SUPABASE_URL=https://pghvmhakfwtxkwvlxokc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional — only required for OpenAI-backed features. The app boots fine
# without it; only requests that call OpenAI will fail if it's unset.
OPENAI_API_KEY=

# Recommended on Vercel: silences Flask debug/test routes and verbose
# tracebacks in production. Defaults to "development" if unset.
FLASK_ENV=production
