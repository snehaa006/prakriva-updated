# Frontend (Vite) — safe to expose, protected by row level security.
# VITE_SUPABASE_ANON_KEY is accepted as an alternate name for the same key.
VITE_SUPABASE_URL=https://pghvmhakfwtxkwvlxokc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the Flask backend (recipe builder, disease detection screening).
# Defaults to http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000

# FoodOScope (RecipeDB) API keys are NOT set here. They live in the
# `foodoscope_api_keys` table in Supabase — add a row per key there and the
# frontend picks it up without a redeploy. See the README.

# Backend only — bypasses row level security, never ship to the browser.
# Falls back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY if unset, but that
# means backend Supabase calls run as the anon role (subject to RLS) instead
# of the privileged service role — set these explicitly for full backend access.
SUPABASE_URL=https://pghvmhakfwtxkwvlxokc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Backend only — powers diet chart generation, the written screening analysis,
# the patient assistant and lab-report extraction. Never give it a VITE_ prefix;
# that would compile the key into the browser bundle. Add spares as
# GEMINI_API_KEY2, GEMINI_API_KEY3, … and each is used when the one before it
# runs out of quota. Unset disables those features, and diet chart generation
# falls back to the FoodOScope recipe path.
GEMINI_API_KEY=
# GEMINI_API_KEY2=
# GEMINI_API_KEY3=

# Backend only — fallback LLM for the chatbot when Gemini is exhausted.
# Groq's free tier (30 req/min, 14.4K req/day on Llama 3.3 70B) keeps
# the chatbot alive while Gemini keys cool down. Same multi-key pattern.
GROQ_API_KEY=
# GROQ_API_KEY2=

# Optional — only required for OpenAI-backed features. The app boots fine
# without it; only requests that call OpenAI will fail if it's unset.
OPENAI_API_KEY=

# Recommended on Vercel: silences Flask debug/test routes and verbose
# tracebacks in production. Defaults to "development" if unset.
FLASK_ENV=production
